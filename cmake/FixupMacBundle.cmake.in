include(BundleUtilities)

get_filename_component(bundle
    "${CMAKE_INSTALL_PREFIX}/@PCINSPECTOR_APPLICATION_NAME@.app"
    ABSOLUTE)
set(search_directories "@pcinspector_dependency_search_dirs@")

if(NOT IS_DIRECTORY "${bundle}")
    message(FATAL_ERROR "Installed application bundle was not found: ${bundle}")
endif()

# macdeployqt handles Qt frameworks. BundleUtilities then copies and rewrites
# the remaining plugins, PDAL, GDAL, and transitive non-system libraries.
# Plugins are not linked by the main executable, so list them explicitly to
# make BundleUtilities rewrite their dependencies to Contents/Frameworks too.
file(GLOB_RECURSE bundle_plugins
     LIST_DIRECTORIES FALSE
     "${bundle}/Contents/PlugIns/*.dylib")
if(NOT bundle_plugins)
    message(FATAL_ERROR "Installed application bundle contains no plugins")
endif()

set(BU_CHMOD_BUNDLE_ITEMS TRUE)
fixup_bundle("${bundle}" "${bundle_plugins}" "${search_directories}")
