<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.dwastberg.PointCloudInspector</id>
  <name>Point Cloud Inspector</name>
  <summary>View and inspect large point-cloud datasets</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.dwastberg">
    <name>Point Cloud Inspector Project</name>
  </developer>
  <description>
    <p>
      Point Cloud Inspector is a GPU-accelerated desktop viewer for LAS, LAZ,
      COPC, and EPT point clouds.
    </p>
    <p>
      It supports large-data navigation, multiple coloring modes, point-cloud
      statistics, measurements, and planar vector overlays.
    </p>
  </description>
  <launchable type="desktop-id">io.github.dwastberg.PointCloudInspector.desktop</launchable>
  <provides>
    <binary>pcinspector</binary>
  </provides>
  <url type="homepage">https://github.com/dwastberg/pointcloudinspector</url>
  <url type="bugtracker">https://github.com/dwastberg/pointcloudinspector/issues</url>
  <releases>
    <release version="@PROJECT_VERSION@"/>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
