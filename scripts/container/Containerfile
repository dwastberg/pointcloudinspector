FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl bzip2 git procps python3 sudo \
    libgl1 libegl1 libopengl0 libxkbcommon0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

# CI's setup-micromamba action also defaults to the latest stable micromamba.
ARG MAMBA_PLATFORM=linux-64
RUN curl --fail --location --retry 3 "https://micro.mamba.pm/api/micromamba/${MAMBA_PLATFORM}/latest" \
    | tar -xj -C /usr/local/bin --strip-components=1 bin/micromamba
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
COPY ci-environment.yml validation-environment-linux.yml /opt/environments/
RUN micromamba create -y -f /opt/environments/ci-environment.yml \
    && micromamba create -y -f /opt/environments/validation-environment-linux.yml \
    && micromamba clean --all --yes

RUN useradd --create-home --uid 1001 --shell /bin/bash builder \
    && mkdir /work \
    && chown builder:builder /work \
    && chmod -R a+rX /opt/micromamba
# Ubuntu GitHub runners include system archive/link tools in addition to conda.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY entrypoint.sh /usr/local/bin/pci-container-entrypoint
RUN bash -n /usr/local/bin/pci-container-entrypoint
ENTRYPOINT ["/bin/bash", "/usr/local/bin/pci-container-entrypoint"]
