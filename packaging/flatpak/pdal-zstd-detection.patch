Backport PDAL's zstd detection fix for SDKs whose dependencies set ZSTD_FOUND
without providing the zstd::libzstd target.
Upstream: https://github.com/PDAL/PDAL/pull/5135

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -272,7 +272,7 @@
         ${WINSOCK_LIBRARY}
 )

-if (ZSTD_FOUND)
+if (PDAL_HAVE_ZSTD)
     target_link_libraries(${PDAL_LIB_NAME}
         PRIVATE
         zstd::libzstd)
diff --git a/cmake/zstd.cmake b/cmake/zstd.cmake
--- a/cmake/zstd.cmake
+++ b/cmake/zstd.cmake
@@ -7,7 +7,7 @@
     find_package(zstd CONFIG QUIET)
     set_package_properties(ZSTD PROPERTIES TYPE
         PURPOSE "General compression support")
-    if (ZSTD_FOUND)
+    if (zstd_FOUND AND TARGET zstd::libzstd)
         set(PDAL_HAVE_ZSTD 1)
-    endif(ZSTD_FOUND)
+    endif()
 endif(WITH_ZSTD)
